 "fields": [
  {"key":"scoreMode","group":"Scoring","type":"enum","values":[0,1,2,3],"labels":["Points","Tracking (time on target)","Stopwatch (lower is better)","Reaction average (lower is better)"],"label":"Scoring","help":"Points: hits, bonuses and penalties. Tracking: +1 per tick on a target. Stopwatch: finish time plus penalties. Reaction: average reaction time plus penalties."},
  {"key":"spHit","group":"Scoring","type":"int","min":0,"max":100000,"label":"Points per hit","help":"Points modes. In score-per-set modes this is paid once per cleared set."},
  {"key":"spMiss","group":"Scoring","type":"int","min":0,"max":100000,"label":"Points lost per miss","help":"Points modes only."},
  {"key":"spLoss","group":"Scoring","type":"int","min":0,"max":100000,"label":"Points lost per lost target","help":"Points modes only. A target is lost when it expires or finishes its pulse unclicked."},
  {"key":"spMissPenalty","group":"Scoring","type":"num","min":0,"max":60,"step":0.1,"label":"Seconds added per miss","help":"Stopwatch mode only."},
  {"key":"bonusProcPrecision","group":"Scoring","type":"int","min":0,"max":5000,"label":"Precision bonus (max)","help":"Paid in proportion to how close to the centre you click."},
  {"key":"bonusProcReaction","group":"Scoring","type":"int","min":0,"max":5000,"label":"Reaction bonus (max)","help":"Full under 160 ms, falling to 0 at the target life."},
  {"key":"bonusProcEff","group":"Scoring","type":"int","min":0,"max":5000,"label":"Path bonus (max)","help":"Pays for straight cursor paths; only efficiency above 80 % counts."},
  {"key":"bonusProcDistance","group":"Scoring","type":"int","min":0,"max":5000,"label":"Distance bonus (max)","help":"Pays for the straight distance covered, as a fraction of the field width."},

  {"key":"targetsOnStart","group":"Targets & spawning","type":"int","min":1,"max":200,"label":"Targets at start","help":""},
  {"key":"maxTargets","group":"Targets & spawning","type":"int","min":0,"max":200,"label":"Maximum targets","help":"Limit for targets added over time or by hits."},
  {"key":"addTargetPeriod","group":"Targets & spawning","type":"int","min":0,"max":3600,"label":"Add a target every (s)","help":"0 = never."},
  {"key":"addTargetHits","group":"Targets & spawning","type":"int","min":0,"max":10000,"label":"Add a target every N hits","help":"0 = never."},
  {"key":"randomTargetPosition","group":"Targets & spawning","type":"bool","label":"Random positions","help":"Off = targets appear in the centre."},
  {"key":"strictInside","group":"Targets & spawning","type":"bool","label":"Keep targets fully inside","help":""},
  {"key":"changePositionOnHit","group":"Targets & spawning","type":"bool","label":"Move after a hit","help":"Off = the target comes back where it was."},
  {"key":"changePositionOnLoss","group":"Targets & spawning","type":"bool","label":"Move after a loss","help":""},
  {"key":"targetDelay","group":"Targets & spawning","type":"int","min":0,"max":30000,"label":"Respawn delay (ms)","help":""},
  {"key":"targetDelayRandom","group":"Targets & spawning","type":"bool","label":"Random delay (0 to delay)","help":"In reaction mode 3 s are added to every non-zero random delay."},
  {"key":"targetLifeTime","group":"Targets & spawning","type":"int","min":0,"max":60000,"label":"Target expires after (ms)","help":"0 = never. An expired target counts as lost."},
  {"key":"hitsToKill","group":"Targets & spawning","type":"int","min":1,"max":20,"label":"Clicks to destroy","help":""},
  {"key":"oneTimeTargets","group":"Targets & spawning","type":"bool","label":"One-time targets","help":"Hit targets never come back."},
  {"key":"syncTarget","group":"Targets & spawning","type":"bool","label":"Synchronised sets","help":"All targets respawn together once every one is gone."},
  {"key":"multiMode","group":"Targets & spawning","type":"bool","label":"Score per set","help":"Needs synchronised sets and at least 2 targets: points, reaction and path are scored once per cleared set."},
  {"key":"disableLosses","group":"Targets & spawning","type":"bool","label":"Do not count losses","help":""},
  {"key":"targetLifePoints","group":"Targets & spawning","type":"int","min":0,"max":6000,"label":"Ticks on target to break it","help":"Tracking mode: after this many ticks on a target it counts as a hit and respawns. 0 = never."},
  {"key":"requireMousePressed","group":"Targets & spawning","type":"bool","label":"Hold the button to track","help":"Tracking mode only."},

  {"key":"radiusMin","group":"Size & pulse","type":"num","min":0.5,"max":100,"step":0.5,"label":"Size from","help":"Size scale 0 to 100: radius = field width x (0.001 + 0.00199 x size)."},
  {"key":"radiusMax","group":"Size & pulse","type":"num","min":0.5,"max":100,"step":0.5,"label":"Size to","help":"Equal sizes = no pulse."},
